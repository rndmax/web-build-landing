# Example only. Do not put real secrets into this file.
# Add these values in GitHub:
# Repository -> Settings -> Secrets and variables -> Actions -> New repository secret.

DEPLOY_HOST=203.0.113.10
DEPLOY_PORT=22
DEPLOY_USER=deploy
DEPLOY_PATH=/var/www/web-build-landing
DEPLOY_KNOWN_HOSTS="example.com ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAA..."

# Store the private SSH key body as GitHub secret DEPLOY_SSH_KEY.
# The matching public key must be present on the server in deploy user's authorized_keys.
DEPLOY_SSH_KEY="-----BEGIN OPENSSH PRIVATE KEY-----..."
